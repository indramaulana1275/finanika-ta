APP_NAME=FINANIKA
APP_ENV=local
APP_KEY=
APP_DEBUG=true

LOG_CHANNEL=stack
LOG_LEVEL=debug

SESSION_DRIVER=file
SESSION_LIFETIME=120

APP_URL=http://localhost
APP_HOST=127.0.0.1
APP_PORT=3000

JWT_SECRET=

CASBIN_MODEL=casbin_model.conf
CASBIN_POLICY=casbin_policy.csv

AI_PROVIDER=

OPENAI_API_KEY=
OPENAI_BASE_URL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Provider cadangan: dipakai otomatis kalau Gemini membalas 429/503.
# Ambil key dari https://console.groq.com/keys.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Halaman Insight Global: true = berita dari feed RSS Google News,
# false = selalu pakai daftar contoh di app/services/insight_service.go.
INSIGHT_FEED=true

HTTP_CLIENT_TIMEOUT=60s
HTTP_REQUEST_TIMEOUT=90
# Batas klien khusus permintaan bergambar ke Gemini (chat lampiran gambar).
# Harus lebih kecil dari HTTP_REQUEST_TIMEOUT; tidak ada kaki Groq di jalur ini.
HTTP_VISION_TIMEOUT=85s

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_edukasi_go
DB_USERNAME=root
DB_PASSWORD=

GRPC_HOST=
GRPC_PORT=

MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
